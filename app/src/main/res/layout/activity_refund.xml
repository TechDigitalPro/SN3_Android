<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/grey_lighter"
    xmlns:card_view="http://schemas.android.com/tools">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/robotoslab_regular"
                android:text="@string/refund"
                android:textColor="@color/white_color"
                android:textSize="@dimen/text_20" />

            <ImageView
                android:id="@+id/imgViewBack"
                android:layout_width="@dimen/margin_30"
                android:layout_height="@dimen/margin_30"
                android:layout_centerVertical="true"
                android:padding="@dimen/padding_3"
                android:layout_marginStart="@dimen/margin_5"
                android:src="@drawable/back_icon_auto_mirrored" />

            <support.ImageBadgeView
                android:id="@+id/imgCheckOut"
                android:layout_width="@dimen/margin_35"
                android:layout_height="@dimen/margin_35"
                android:layout_marginTop="@dimen/margin_10"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/margin_12"
                app:ibv_badgeValue="3"
                app:ibv_badgeTextSize="12sp"
                app:ibv_fixedBadgeRadius="8dp"
                app:ibv_badgeTextStyle="bold"
                app:ibv_badgeTextColor="@color/colorPrimary"
                app:ibv_badgePosition="top_right"
                app:ibv_badgeColor="@color/white_color"
                app:ibv_badgeLimitValue="false"
                android:src="@mipmap/ic_basket_empty" />
        </RelativeLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/robotoslab_bold"
                    android:text="@string/select_refund_method"
                    android:layout_marginTop="@dimen/margin_40"
                    android:textColor="@color/black_color"
                    android:textSize="@dimen/text_17" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_20"
                    android:padding="@dimen/padding_30"
                    android:orientation="vertical"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_bold"
                            android:text="1."
                            android:textAllCaps="false"
                            android:textColor="@color/black_color"
                            android:textSize="@dimen/text_16" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_regular"
                            android:text="@string/bank_transfer"
                            android:textAllCaps="false"
                            android:layout_marginStart="@dimen/margin_4"
                            android:textColor="@color/black_color"
                            android:textSize="@dimen/text_15" />
                        <RadioButton
                            android:id="@+id/option_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_regular"
                            android:textSize="12sp"
                            android:layout_marginStart="@dimen/margin_12"
                            android:layout_marginBottom="10dp"
                            android:checked="true"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/robotoslab_regular"
                        android:text="@string/bank_refund_description"
                        android:textAllCaps="false"
                        android:layout_gravity="center"
                        android:textColor="@color/black_color"
                        android:padding="@dimen/padding_15"
                        android:layout_margin="@dimen/margin_12"
                        android:background="@drawable/rounded_border_refund"
                        android:textSize="@dimen/text_13" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/margin_12"
                        android:gravity="center"
                        >
                        <View
                            android:layout_width="@dimen/margin_50"
                            android:layout_height="1dp"
                            android:background="@color/black_color"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/margin_12"
                            android:fontFamily="@font/robotoslab_regular"
                            android:text="@string/or"
                            android:textAllCaps="false"
                            android:textColor="@color/black_color"
                            android:textSize="@dimen/text_12" />
                        <View
                            android:layout_width="@dimen/margin_50"
                            android:layout_height="1dp"
                            android:background="@color/black_color"
                            />
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/margin_12"
                        >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_bold"
                            android:text="2."
                            android:textAllCaps="false"
                            android:textColor="@color/black_color"
                            android:textSize="@dimen/text_16" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_regular"
                            android:text="@string/wallet"
                            android:textAllCaps="false"
                            android:layout_marginStart="@dimen/margin_4"
                            android:textColor="@color/black_color"
                            android:textSize="@dimen/text_15" />
                        <RadioButton
                            android:id="@+id/option_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_regular"
                            android:textSize="12sp"
                            android:layout_marginStart="@dimen/margin_12"
                            android:layout_marginBottom="10dp"
                            android:checked="false"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/robotoslab_regular"
                        android:text="@string/wallet_refund_description"
                        android:textAllCaps="false"
                        android:layout_gravity="center"
                        android:textColor="@color/black_color"
                        android:padding="@dimen/padding_15"
                        android:layout_margin="@dimen/margin_12"
                        android:background="@drawable/rounded_border_refund"
                        android:textSize="@dimen/text_13" />

                    <TextView
                        android:layout_gravity="center"
                        android:layout_width="@dimen/margin_200"
                        android:layout_height="45dp"
                        android:layout_marginTop="@dimen/margin_150"
                        android:background="@drawable/rounded_background"
                        android:elevation="@dimen/margin_3"
                        android:fontFamily="@font/robotoslab_regular"
                        android:gravity="center"
                        android:text="@string/proceed"
                        android:textAllCaps="false"
                        android:textColor="@color/white_color"
                        android:textSize="@dimen/text_16" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>


</RelativeLayout>
