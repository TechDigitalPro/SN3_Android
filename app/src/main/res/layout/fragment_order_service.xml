<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_50"
                android:background="@color/colorPrimary"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/robotoslab_regular"
                    android:text="@string/order"
                    android:textColor="@color/white_color"
                    android:textSize="@dimen/text_20" />

                <ImageView
                    android:id="@+id/imgViewBack"
                    android:layout_width="@dimen/margin_45"
                    android:layout_height="@dimen/margin_60"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/margin_5"
                    android:padding="@dimen/padding_10"
                    android:src="@drawable/back_icon_auto_mirrored" />

                <support.ImageBadgeView
                    android:id="@+id/imgCheckOut"
                    android:layout_width="@dimen/margin_50"
                    android:layout_height="@dimen/margin_50"
                    android:layout_marginTop="@dimen/margin_10"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="@dimen/margin_12"
                    app:ibv_badgeValue="3"
                    app:ibv_badgeTextSize="12sp"
                    app:ibv_fixedBadgeRadius="8dp"
                    app:ibv_badgeTextStyle="bold"
                    app:ibv_badgeTextColor="@color/colorPrimary"
                    app:ibv_badgePosition="top_right"
                    app:ibv_badgeColor="@color/white_color"
                    app:ibv_badgeLimitValue="false"
                    android:src="@mipmap/ic_basket_empty" />
            </RelativeLayout>
           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="vertical"
               >
               <androidx.recyclerview.widget.RecyclerView
                   android:id="@+id/rv_order_service"
                   android:layout_marginTop="@dimen/margin_20"
                   android:layout_marginBottom="@dimen/margin_10"
                   android:layout_marginStart="@dimen/margin_5"
                   android:layout_marginEnd="@dimen/margin_5"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:orientation="horizontal"
                   />
           </LinearLayout>
        </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>