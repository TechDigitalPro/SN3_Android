<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/grey_lighter"
    xmlns:card_view="http://schemas.android.com/tools">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/robotoslab_regular"
                android:text="@string/about_sn3"
                android:textColor="@color/white_color"
                android:textSize="@dimen/text_20" />

            <ImageView
                android:id="@+id/imgViewBack"
                android:layout_width="@dimen/margin_30"
                android:layout_height="@dimen/margin_30"
                android:layout_centerVertical="true"
                android:padding="@dimen/padding_3"
                android:layout_marginStart="@dimen/margin_5"
                android:src="@drawable/back_icon_auto_mirrored" />

            <support.ImageBadgeView
                android:id="@+id/imgCheckOut"
                android:layout_width="@dimen/margin_35"
                android:layout_height="@dimen/margin_35"
                android:layout_marginTop="@dimen/margin_10"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/margin_12"
                app:ibv_badgeValue="3"
                app:ibv_badgeTextSize="12sp"
                app:ibv_fixedBadgeRadius="8dp"
                app:ibv_badgeTextStyle="bold"
                app:ibv_badgeTextColor="@color/colorPrimary"
                app:ibv_badgePosition="top_right"
                app:ibv_badgeColor="@color/white_color"
                app:ibv_badgeLimitValue="false"
                android:src="@mipmap/ic_basket_empty" />
        </RelativeLayout>

        <ImageView
            android:layout_width="@dimen/margin_70"
            android:layout_height="@dimen/margin_70"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/margin_10"
            android:layout_marginBottom="@dimen/margin_5"
            android:src="@drawable/ic_logo" />
        <ScrollView
            android:layout_width="match_parent"
            android:background="@drawable/rounded_border_refund"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/margin_20"
            android:layout_marginEnd="@dimen/margin_20"
            android:padding="@dimen/padding_3"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/robotoslab_regular"
                    android:text="The amount will be transferred to the account used paying for the product/serviceThe amount will be transferred to the account used paying for the product/serviceThe amount will be transferred to the account used paying for the product/serviceThe amount will be transferred to the account used paying for the product/serviceThe amount will be transferred to the account used paying for the product/serviceThe amount will be transferred to the account used paying for the product/serviceThe amount will be transferred to the account used paying for the product/serviceThe amount will be transferred to the account used paying for the product/serviceThe amount will be transferred to the account used paying for the product/serviceThe amount will be transferred to the account used paying for the product/serviceThe amount will be transferred to the account used paying for the product/serviceThe amount will be transferred to the account used paying for the product/serviceThe amount will be transferred to the account used paying for the product/serviceThe amount will be transferred to the account used paying for the product/serviceThe amount will be transferred to the account used paying for the product/serviceThe amount will be transferred to the account used paying for the product/serviceThe amount will be transferred to the account used paying for the product/serviceThe amount will be transferred to the account used paying for the product/servicThe amount will be transferred to the account used paying for the product/serviceThe amount will be transferred to the account used paying for the product/serviceThe amount will be transferred to the account used paying for the product/serviceThe amount will be transferred to the account used paying for the product/servicee"
                    android:textAllCaps="false"
                    android:layout_gravity="center"
                    android:textColor="@color/black_color"
                    android:layout_margin="@dimen/margin_12"
                    android:textSize="@dimen/text_13" />

            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_margin="@dimen/margin_5"
            >
            <ImageView
                android:layout_width="@dimen/margin_50"
                android:layout_height="@dimen/margin_50"
                android:padding="@dimen/padding_5"
                android:layout_marginStart="@dimen/margin_5"
                android:src="@mipmap/ic_contact_phone"
                />
            <ImageView
                android:layout_width="@dimen/margin_50"
                android:layout_height="@dimen/margin_50"
                android:padding="@dimen/padding_5"
                android:layout_marginStart="@dimen/margin_5"
                android:src="@mipmap/ic_contact_email" />
            <ImageView
                android:layout_width="@dimen/margin_50"
                android:layout_height="@dimen/margin_50"
                android:layout_marginStart="@dimen/margin_5"
                android:src="@mipmap/ic_contact_whatsapp" />
        </LinearLayout>
    </LinearLayout>


</RelativeLayout>
