<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:card_view="http://schemas.android.com/tools">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/robotoslab_regular"
                android:text="@string/registration"
                android:textColor="@color/white_color"
                android:textSize="@dimen/text_20" />

            <ImageView
                android:id="@+id/imgViewBack"
                android:layout_width="@dimen/margin_30"
                android:layout_height="@dimen/margin_30"
                android:layout_centerVertical="true"
                android:padding="@dimen/padding_3"
                android:layout_marginStart="@dimen/margin_5"
                android:src="@drawable/back_icon_auto_mirrored" />

            <support.ImageBadgeView
                android:id="@+id/imgCheckOut"
                android:layout_width="@dimen/margin_35"
                android:layout_height="@dimen/margin_35"
                android:layout_marginTop="@dimen/margin_10"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/margin_12"
                app:ibv_badgeValue="3"
                app:ibv_badgeTextSize="12sp"
                app:ibv_fixedBadgeRadius="8dp"
                app:ibv_badgeTextStyle="bold"
                app:ibv_badgeTextColor="@color/colorPrimary"
                app:ibv_badgePosition="top_right"
                app:ibv_badgeColor="@color/white_color"
                app:ibv_badgeLimitValue="false"
                android:src="@mipmap/ic_basket_empty" />
        </RelativeLayout>
        <LinearLayout
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/grey_lighter"
            android:orientation="vertical"
            android:paddingTop="@dimen/margin_150"
            >
            <ImageView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/ic_buy_basket"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_8"
                android:layout_gravity="center"
                android:orientation="vertical"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_4"

                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_3"
                                android:fontFamily="@font/robotoslab_regular"
                                android:text="@string/your_cart_is_empty"
                                android:gravity="center"
                                android:textColor="@color/dark_text_color"
                                android:textSize="@dimen/text_25" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
                <TextView

                    android:layout_width="@dimen/margin_200"
                    android:layout_height="45dp"
                    android:layout_marginTop="@dimen/margin_20"
                    android:background="@drawable/rounded_background"
                    android:elevation="@dimen/margin_3"
                    android:fontFamily="@font/robotoslab_regular"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:text="@string/explore_our_deals"
                    android:textAllCaps="false"
                    android:textColor="@color/white_color"
                    android:textSize="@dimen/text_16" />

            </LinearLayout>
        </LinearLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/margin_10"
                    android:paddingTop="@dimen/padding_30"
                    android:paddingBottom="@dimen/padding_30"
                    android:paddingStart="@dimen/padding_10"
                    android:paddingEnd="@dimen/padding_10"
                    >


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/padding_20"
                    android:layout_marginEnd="@dimen/padding_20">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/robotoslab_regular"
                        android:text="@string/first_name"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/Text_Filed_Value_text_size" />

                    <EditText
                        android:id="@+id/editName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/first_name"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:imeOptions="actionNext"
                        android:theme="@style/EditTextStyle" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/margin_12"
                    android:paddingLeft="@dimen/padding_20"
                    android:paddingRight="@dimen/padding_20">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/robotoslab_regular"
                        android:text="@string/second_name"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/Text_Filed_Value_text_size" />

                    <EditText
                        android:id="@+id/editEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/second_name"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName"
                        android:theme="@style/EditTextStyle" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/margin_12"
                    android:paddingLeft="@dimen/padding_20"
                    android:paddingRight="@dimen/padding_20">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/robotoslab_regular"
                        android:text="@string/national_id"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/Text_Filed_Value_text_size" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center"
                        >
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                >

                                <EditText
                                    android:id="@+id/editPassword"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/national_id"
                                    android:inputType="number"
                                    android:theme="@style/EditTextStyle" />

                            </RelativeLayout>
                        </LinearLayout>


                    </LinearLayout>


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/margin_12"
                    android:paddingLeft="@dimen/padding_20"

                    android:paddingRight="@dimen/padding_20">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/robotoslab_regular"
                        android:text="@string/your_phone"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/text_12" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:orientation="horizontal">

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="2">

                            <com.hbb20.CountryCodePicker
                                android:id="@+id/country_picker"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_above="@+id/subline"
                                android:layout_centerHorizontal="true"
                                android:layout_marginBottom="@dimen/margin_3"
                                app:ccp_arrowColor="@color/colorPrimary"
                                app:ccp_arrowSize="@dimen/Screen_Title_text_size"
                                app:ccp_contentColor="@color/colorBlack"
                                app:ccp_defaultNameCode="SA"
                                app:ccp_padding="0dp"
                                app:ccp_textSize="@dimen/text_13" />

                            <View
                                android:id="@+id/subline"
                                android:layout_width="match_parent"
                                android:layout_height="1.5dp"
                                android:layout_alignParentBottom="true"
                                android:layout_marginBottom="9.5dp"
                                android:background="@color/colorPrimary" />

                        </RelativeLayout>

                        <EditText
                            android:id="@+id/edit_phoneNumber"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:hint="000 000 0000"
                            android:inputType="phone"
                            android:theme="@style/EditTextStyle" />
                    </LinearLayout>

                </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtNo"
                    android:layout_width="@dimen/margin_280"
                    android:layout_height="45dp"
                    android:background="@drawable/rounded_border_grey"
                    android:fontFamily="@font/robotoslab_regular"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:text="@string/receive_code_vis_sms"
                    android:textAllCaps="false"
                    android:textColor="@color/light_text_color"
                    android:layout_marginBottom="@dimen/margin_10"
                    android:textSize="@dimen/text_14" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/padding_30"
                    android:paddingTop="@dimen/padding_20"
                    android:paddingStart="@dimen/padding_30"
                    android:paddingBottom="@dimen/padding_10">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/robotoslab_regular"
                        android:text="@string/enter_code"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/text_12" />

                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="123456"
                        android:inputType="phone"
                        android:theme="@style/EditTextStyle" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        >
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/margin_5"
                            android:orientation="horizontal">
                            <CheckBox
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                />
                            <TextView

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/robotoslab_regular"
                                android:text="@string/I_agree_to_the"
                                android:textAllCaps="false"
                                android:textColor="@color/grey_light"
                                android:textSize="@dimen/text_11" />
                            <TextView

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/robotoslab_regular"
                                android:layout_marginStart="@dimen/margin_3"

                                android:text="@string/terms_and_condition"
                                android:textAllCaps="false"
                                android:textColor="@color/grey_dark"
                                android:textSize="@dimen/text_11" />
                        </LinearLayout>
                        <TextView

                            android:layout_width="@dimen/margin_150"
                            android:layout_height="45dp"
                            android:background="@drawable/rounded_background"
                            android:elevation="@dimen/margin_3"
                            android:fontFamily="@font/robotoslab_regular"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:text="@string/sign_up"
                            android:textAllCaps="false"
                            android:textColor="@color/white_color"
                            android:textSize="@dimen/text_16" />

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

    </LinearLayout>


</RelativeLayout>
