<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:card_view="http://schemas.android.com/tools">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/robotoslab_regular"
                android:text="@string/complain"
                android:textColor="@color/white_color"
                android:textSize="@dimen/text_20" />

            <ImageView
                android:id="@+id/imgViewBack"
                android:layout_width="@dimen/margin_30"
                android:layout_height="@dimen/margin_30"
                android:layout_centerVertical="true"
                android:padding="@dimen/padding_3"
                android:layout_marginStart="@dimen/margin_5"
                android:src="@drawable/back_icon_auto_mirrored" />

            <support.ImageBadgeView
                android:id="@+id/imgCheckOut"
                android:layout_width="@dimen/margin_35"
                android:layout_height="@dimen/margin_35"
                android:layout_marginTop="@dimen/margin_10"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/margin_12"
                app:ibv_badgeValue="3"
                app:ibv_badgeTextSize="12sp"
                app:ibv_fixedBadgeRadius="8dp"
                app:ibv_badgeTextStyle="bold"
                app:ibv_badgeTextColor="@color/colorPrimary"
                app:ibv_badgePosition="top_right"
                app:ibv_badgeColor="@color/white_color"
                app:ibv_badgeLimitValue="false"
                android:src="@mipmap/ic_basket_empty" />
        </RelativeLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="0dp"
                    app:cardElevation="@dimen/margin_10"
                    app:cardUseCompatPadding="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        >


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_margin="@dimen/margin_20"
                            >
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_12"
                                android:layout_marginBottom="@dimen/margin_12"
                                android:orientation="horizontal">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/margin_100"
                                    android:background="@color/white_color"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_weight="1"

                                        android:layout_height="match_parent">
                                        <ImageView
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:src="@drawable/test_2" />
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical"
                                        android:paddingStart="@dimen/padding_15"
                                        android:layout_height="match_parent">
                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/robotoslab_regular"
                                            android:paddingTop="@dimen/padding_10"
                                            android:text="Clean House"
                                            android:textColor="@color/colorPrimary"
                                            android:textSize="@dimen/text_12" />
                                        <TextView
                                            android:layout_marginTop="@dimen/margin_5"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/robotoslab_regular"
                                            android:text="The chrome finish of this kitchen faucet is highly reflective."
                                            android:textColor="#414141"
                                            android:textSize="@dimen/text_11" />
                                    </LinearLayout>



                                </LinearLayout>
                            </LinearLayout>
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/margin_1"
                                android:background="@color/grey_white"
                                />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_12"
                                android:orientation="horizontal">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"

                                    android:background="@color/white_color"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_weight="1"
                                        android:layout_height="wrap_content">

                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/robotoslab_regular"
                                            android:text="@string/duration"
                                            android:textColor="#414141"
                                            android:textSize="@dimen/text_11" />
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical"
                                        android:layout_height="wrap_content">
                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/robotoslab_bold"
                                            android:gravity="end"
                                            android:text="2 months"
                                            android:textColor="#505050"
                                            android:textSize="@dimen/text_11" />
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_4"

                                android:orientation="horizontal">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"

                                    android:background="@color/white_color"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_weight="1"
                                        android:layout_height="wrap_content">

                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/robotoslab_regular"
                                            android:text="@string/type_of_contract"
                                            android:textColor="#414141"
                                            android:textSize="@dimen/text_11" />
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical"
                                        android:layout_height="wrap_content">
                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/robotoslab_bold"
                                            android:gravity="end"
                                            android:text="Multi visit"
                                            android:textColor="#505050"
                                            android:textSize="@dimen/text_11" />
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_4"

                                android:orientation="horizontal">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"

                                    android:background="@color/white_color"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_weight="1"
                                        android:layout_height="wrap_content">

                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/robotoslab_regular"
                                            android:text="@string/days_of_service"
                                            android:textColor="#414141"
                                            android:textSize="@dimen/text_11" />
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical"
                                        android:layout_height="wrap_content">
                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/robotoslab_bold"
                                            android:gravity="end"
                                            android:text="2 times / week"
                                            android:textColor="#505050"
                                            android:textSize="@dimen/text_11" />
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_4"
                                android:layout_marginBottom="@dimen/margin_15"
                                android:orientation="horizontal">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"

                                    android:background="@color/white_color"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_weight="1"
                                        android:layout_height="wrap_content">

                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/robotoslab_regular"
                                            android:text="@string/performer"
                                            android:textColor="#414141"
                                            android:textSize="@dimen/text_11" />
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical"
                                        android:layout_height="wrap_content">
                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/robotoslab_bold"
                                            android:gravity="end"
                                            android:text="Phillipines"
                                            android:textColor="#505050"
                                            android:textSize="@dimen/text_11" />
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>


                        </LinearLayout>

                        <TextView
                            android:layout_marginTop="@dimen/margin_5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_regular"
                            android:text="@string/please_select_the_main_reason_complain"
                            android:layout_gravity="center"
                            android:textColor="#414141"
                            android:textSize="@dimen/text_11" />
                        <Spinner
                            android:textDirection="ltr"
                            android:id="@+id/category_spinner"
                            style="@style/SpinnerTheme"
                            android:layout_marginTop="@dimen/margin_10"
                            android:layout_gravity="center"
                            android:layout_width="match_parent"
                            android:layout_marginStart="@dimen/margin_30"
                            android:layout_marginEnd="@dimen/margin_30"
                            android:layout_height="wrap_content"
                            />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_margin="@dimen/margin_20"
                            >
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/robotoslab_regular"
                                android:text="@string/please_describe_what_happened"
                                android:textColor="@color/colorDarkGray"
                                android:textSize="@dimen/Text_Filed_Value_text_size" />

                            <EditText
                                android:id="@+id/message"
                                android:layout_marginTop="@dimen/margin_5"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/write_your_feedback"
                                android:minHeight="@dimen/margin_150"
                                android:paddingTop="@dimen/padding_8"
                                android:gravity="start"
                                android:background="@color/grey_lighter"
                                android:theme="@style/EditTextStyle" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/txtNo"
                            android:layout_width="150dp"
                            android:layout_height="45dp"
                            android:background="@drawable/rounded_border"
                            android:fontFamily="@font/robotoslab_bold"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:text="@string/send_complain"
                            android:textAllCaps="false"
                            android:textColor="@color/colorPrimary"
                            android:layout_marginBottom="@dimen/margin_20"
                            android:textSize="@dimen/text_13" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>


</RelativeLayout>
