<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:card_view="http://schemas.android.com/tools">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/robotoslab_regular"
                android:text="@string/payment_detail"
                android:textColor="@color/white_color"
                android:textSize="@dimen/text_20" />

            <ImageView
                android:id="@+id/imgViewBack"
                android:layout_width="@dimen/margin_30"
                android:layout_height="@dimen/margin_30"
                android:layout_centerVertical="true"
                android:padding="@dimen/padding_3"
                android:layout_marginStart="@dimen/margin_5"
                android:src="@drawable/back_icon_auto_mirrored" />

            <support.ImageBadgeView
                android:id="@+id/imgCheckOut"
                android:layout_width="@dimen/margin_35"
                android:layout_height="@dimen/margin_35"
                android:layout_marginTop="@dimen/margin_10"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/margin_12"
                app:ibv_badgeValue="3"
                app:ibv_badgeTextSize="12sp"
                app:ibv_fixedBadgeRadius="8dp"
                app:ibv_badgeTextStyle="bold"
                app:ibv_badgeTextColor="@color/colorPrimary"
                app:ibv_badgePosition="top_right"
                app:ibv_badgeColor="@color/white_color"
                app:ibv_badgeLimitValue="false"
                android:src="@mipmap/ic_basket_empty" />
        </RelativeLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:padding="@dimen/padding_30"
                    android:layout_marginTop="@dimen/margin_20"
                    android:layout_marginBottom="@dimen/margin_20"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/robotoslab_regular"
                        android:text="@string/seelct_payment_method"
                        android:textColor="@color/black_color"
                        android:gravity="center"
                        android:textSize="@dimen/text_16" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_30"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_marginEnd="@dimen/margin_12"
                                android:layout_weight="1"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/margin_45"
                                    android:fontFamily="@font/robotoslab_regular"
                                    android:text="@string/card"
                                    android:gravity="center"
                                    android:textColor="@color/colorPrimary"
                                    android:background="@drawable/rounded_border"
                                    android:textSize="@dimen/text_14" />

                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/margin_12"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/margin_45"
                                    android:fontFamily="@font/robotoslab_regular"
                                    android:text="@string/bank_transfer"
                                    android:gravity="center"
                                    android:textColor="@color/grey_dark"
                                    android:background="@drawable/rounded_border_grey"
                                    android:textSize="@dimen/text_14" />

                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_20"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/margin_50"
                                    android:fontFamily="@font/robotoslab_regular"
                                    android:text="@string/cash_card_on_delivery"
                                    android:gravity="center"
                                    android:textColor="@color/grey_dark"
                                    android:background="@drawable/rounded_border_grey"
                                    android:textSize="@dimen/text_14" />

                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>



                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_40"
                    android:fontFamily="@font/robotoslab_regular"
                    android:text="@string/we_are_supported_by"
                    android:textColor="@color/dark_text_color"
                    android:gravity="center"
                    android:textSize="@dimen/text_16" />

                <ImageView
                    android:layout_marginTop="@dimen/margin_25"
                    android:layout_width="@dimen/margin_200"
                    android:layout_height="@dimen/margin_60"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_visa_master"/>

                <TextView
                    android:layout_width="@dimen/margin_250"
                    android:layout_height="@dimen/margin_45"
                    android:layout_marginTop="@dimen/margin_50"
                    android:fontFamily="@font/robotoslab_regular"
                    android:text="@string/proceed"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:textColor="@color/colorPrimary"
                    android:background="@drawable/rounded_border"
                    android:textSize="@dimen/text_16" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>


</RelativeLayout>
