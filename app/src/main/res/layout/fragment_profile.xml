<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_50"
                android:background="@color/colorPrimary"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/robotoslab_regular"
                    android:text="@string/profile"
                    android:textColor="@color/white_color"
                    android:textSize="@dimen/text_20" />

                <ImageView
                    android:id="@+id/imgViewBack"
                    android:layout_width="@dimen/margin_45"
                    android:layout_height="@dimen/margin_60"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/margin_5"
                    android:padding="@dimen/padding_10"
                    android:src="@drawable/back_icon_auto_mirrored" />

                <support.ImageBadgeView
                    android:id="@+id/imgCheckOut"
                    android:layout_width="@dimen/margin_50"
                    android:layout_height="@dimen/margin_50"
                    android:layout_marginTop="@dimen/margin_10"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="@dimen/margin_12"
                    app:ibv_badgeValue="3"
                    app:ibv_badgeTextSize="12sp"
                    app:ibv_fixedBadgeRadius="8dp"
                    app:ibv_badgeTextStyle="bold"
                    app:ibv_badgeTextColor="@color/colorPrimary"
                    app:ibv_badgePosition="top_right"
                    app:ibv_badgeColor="@color/white_color"
                    app:ibv_badgeLimitValue="false"
                    android:src="@mipmap/ic_basket_empty" />
            </RelativeLayout>
           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="vertical"
               android:background="@color/white_color"

               android:paddingTop="@dimen/padding_15"
               android:paddingBottom="@dimen/padding_15"
               >
               <LinearLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:orientation="vertical">
                   <LinearLayout
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:orientation="horizontal">
                       <LinearLayout
                           android:layout_width="0dp"
                           android:layout_weight="1"
                           android:layout_height="match_parent"
                           android:orientation="vertical"
                           android:gravity="center"
                           >
                           <ImageView
                               android:layout_width="wrap_content"
                               android:layout_height="wrap_content"
                               android:src="@mipmap/ic_chart"
                               />
                           <TextView
                               android:layout_width="wrap_content"
                               android:layout_height="wrap_content"
                               android:fontFamily="@font/robotoslab_regular"
                               android:gravity="center"
                               android:text="@string/statistics"
                               android:textColor="@color/dark_text_color"
                               android:textSize="@dimen/text_12" />
                       </LinearLayout>
                       <LinearLayout
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           android:orientation="vertical"
                           >
                           <de.hdodenhof.circleimageview.CircleImageView
                               android:layout_margin="3dip"
                               android:layout_width="@dimen/margin_150"
                               android:layout_height="@dimen/margin_150"
                               android:src="@drawable/test_5"
                               app:civ_border_width="2dip"
                               app:civ_border_color="@color/colorPrimary"
                               />
                           <de.hdodenhof.circleimageview.CircleImageView
                               android:id="@+id/imgViewAvartar"
                               android:layout_width="@dimen/margin_50"
                               android:layout_height="@dimen/margin_50"
                               android:layout_gravity="center"
                               android:layout_marginTop="-30dp"
                               android:src="@mipmap/ic_camera"
                               app:civ_border_color="@color/colorLightGreen" />

                       </LinearLayout>
                       <LinearLayout
                           android:layout_width="0dp"
                           android:layout_weight="1"
                           android:layout_height="match_parent"
                           android:orientation="vertical"
                           android:gravity="center"
                           >
                           <ImageView
                               android:layout_width="wrap_content"
                               android:layout_height="wrap_content"
                               android:src="@mipmap/ic_favorite_black"
                               />
                           <TextView
                               android:layout_width="wrap_content"
                               android:layout_height="wrap_content"
                               android:fontFamily="@font/robotoslab_regular"
                               android:gravity="center"
                               android:text="@string/favorites"
                               android:textColor="@color/dark_text_color"
                               android:textSize="@dimen/text_12" />
                       </LinearLayout>

                   </LinearLayout>
               </LinearLayout>
               <TextView
                   android:id="@+id/txtName"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_gravity="center"
                   android:fontFamily="@font/robotoslab_bold"
                   android:text="Sara Jonson"
                   android:textColor="@color/dark_text_color"
                   android:textSize="@dimen/text_15" />
               <TextView
                   android:id="@+id/txtPhoneNumber"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:gravity="center"
                   android:layout_gravity="center"
                   android:fontFamily="@font/robotoslab_regular"
                   android:text="North 31 St, Quen Blv, New Jerssy"
                   android:textColor="@color/grey_light"
                   android:textSize="@dimen/text_11" />
           </LinearLayout>

            <LinearLayout
                android:layout_marginTop="@dimen/margin_8"
                android:background="@color/white_color"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                >
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:orientation="vertical"
                        android:paddingBottom="@dimen/padding_8"
                        android:layout_height="match_parent">


                <LinearLayout
                    android:layout_marginTop="@dimen/margin_8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >
                    <ImageView
                        android:layout_marginStart="@dimen/margin_12"
                        android:padding="@dimen/padding_5"
                        android:layout_width="@dimen/margin_40"
                        android:layout_height="@dimen/margin_40"
                        android:src="@mipmap/ic_setting"
                        />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/margin_4"
                        android:layout_marginEnd="@dimen/margin_20"
                        android:gravity="bottom"
                        >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/robotoslab_regular"
                            android:gravity="center"
                            android:layout_marginStart="@dimen/margin_4"
                            android:text="@string/settings"
                            android:textColor="@color/dark_text_color"
                            android:textSize="@dimen/text_14" />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="@dimen/margin_1"
                            android:background="@color/grey_button"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="@dimen/margin_8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >
                    <ImageView
                        android:layout_marginStart="@dimen/margin_12"
                        android:layout_width="@dimen/margin_40"
                        android:layout_height="@dimen/margin_40"
                        android:padding="@dimen/padding_5"

                        android:src="@mipmap/ic_card"
                        />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/margin_4"
                        android:layout_marginEnd="@dimen/margin_20"
                        android:gravity="bottom"
                        >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/robotoslab_regular"
                            android:gravity="center"
                            android:layout_marginStart="@dimen/margin_4"
                            android:text="@string/credit_cards"
                            android:textColor="@color/dark_text_color"
                            android:textSize="@dimen/text_14" />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="@dimen/margin_1"
                            android:background="@color/grey_button"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="@dimen/margin_8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >
                    <ImageView
                        android:layout_marginStart="@dimen/margin_12"
                        android:layout_width="@dimen/margin_40"
                        android:layout_height="@dimen/margin_40"
                        android:src="@mipmap/ic_phone"
                        />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/margin_4"
                        android:layout_marginEnd="@dimen/margin_20"
                        android:gravity="bottom"
                        >
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/robotoslab_regular"
                                android:gravity="center"
                                android:layout_marginStart="@dimen/margin_4"
                                android:text="@string/phone_number"
                                android:textColor="@color/dark_text_color"
                                android:textSize="@dimen/text_14" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/robotoslab_regular"
                                android:gravity="center"
                                android:layout_alignParentEnd="true"
                                android:layout_marginEnd="@dimen/margin_4"
                                android:text="+1234567890"
                                android:textColor="@color/dark_text_color"
                                android:textSize="@dimen/text_14" />
                        </RelativeLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="@dimen/margin_1"
                            android:background="@color/grey_button"/>
                    </LinearLayout>

                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="@dimen/margin_8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >
                    <ImageView
                        android:layout_marginStart="@dimen/margin_12"
                        android:layout_width="@dimen/margin_40"
                        android:layout_height="@dimen/margin_40"
                        android:padding="@dimen/padding_5"

                        android:src="@mipmap/ic_text"
                        />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/margin_4"
                        android:layout_marginEnd="@dimen/margin_20"
                        android:gravity="bottom"
                        >
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/robotoslab_regular"
                                android:gravity="center"
                                android:layout_marginStart="@dimen/margin_4"
                                android:text="@string/national_id"
                                android:textColor="@color/dark_text_color"
                                android:textSize="@dimen/text_14" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/robotoslab_regular"
                                android:gravity="center"
                                android:layout_alignParentEnd="true"
                                android:layout_marginEnd="@dimen/margin_4"
                                android:text="5446852325"
                                android:textColor="@color/dark_text_color"
                                android:textSize="@dimen/text_14" />
                        </RelativeLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="@dimen/margin_1"
                            android:background="@color/grey_button"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="@dimen/margin_8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >
                    <ImageView
                        android:layout_marginStart="@dimen/margin_12"
                        android:layout_width="@dimen/margin_40"
                        android:layout_height="@dimen/margin_40"
                        android:src="@mipmap/ic_twitter"
                        android:padding="@dimen/padding_5"

                        />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/margin_4"
                        android:layout_marginEnd="@dimen/margin_20"
                        android:gravity="bottom"
                        >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/robotoslab_regular"
                            android:gravity="center"
                            android:layout_marginStart="@dimen/margin_4"
                            android:text="@string/login_twitter"
                            android:textColor="@color/dark_text_color"
                            android:textSize="@dimen/text_14" />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="@dimen/margin_1"
                            android:background="@color/grey_button"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="@dimen/margin_8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >
                    <ImageView
                        android:layout_marginStart="@dimen/margin_12"
                        android:layout_width="@dimen/margin_40"
                        android:layout_height="@dimen/margin_40"
                        android:src="@mipmap/ic_loge_out"
                        android:padding="@dimen/padding_5"

                        />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/margin_4"
                        android:layout_marginEnd="@dimen/margin_20"
                        android:gravity="bottom"
                        >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/robotoslab_regular"
                            android:gravity="center"
                            android:layout_marginStart="@dimen/margin_4"
                            android:text="@string/delete_account"
                            android:textColor="@color/dark_text_color"
                            android:textSize="@dimen/text_14" />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="@dimen/margin_1"
                            android:background="@color/grey_button"/>
                    </LinearLayout>
                </LinearLayout>
                    </LinearLayout>

                </ScrollView>
            </LinearLayout>

        </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>