<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:card_view="http://schemas.android.com/tools">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/robotoslab_regular"
                android:text="@string/description"
                android:textColor="@color/white_color"
                android:textSize="@dimen/text_20" />

            <ImageView
                android:id="@+id/imgViewBack"
                android:layout_width="@dimen/margin_30"
                android:layout_height="@dimen/margin_30"
                android:layout_centerVertical="true"
                android:padding="@dimen/padding_3"
                android:layout_marginStart="@dimen/margin_5"
                android:src="@drawable/back_icon_auto_mirrored" />

            <support.ImageBadgeView
                android:id="@+id/imgCheckOut"
                android:layout_width="@dimen/margin_35"
                android:layout_height="@dimen/margin_35"
                android:layout_marginTop="@dimen/margin_10"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/margin_12"
                app:ibv_badgeValue="3"
                app:ibv_badgeTextSize="12sp"
                app:ibv_fixedBadgeRadius="8dp"
                app:ibv_badgeTextStyle="bold"
                app:ibv_badgeTextColor="@color/colorPrimary"
                app:ibv_badgePosition="top_right"
                app:ibv_badgeColor="@color/white_color"
                app:ibv_badgeLimitValue="false"
                android:src="@mipmap/ic_basket_empty" />
        </RelativeLayout>
        <LinearLayout
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/grey_lighter"
            android:orientation="vertical"
            android:paddingTop="@dimen/margin_150"
            >
            <ImageView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/ic_buy_basket"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_8"
                android:layout_gravity="center"
                android:orientation="vertical"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_4"

                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_3"
                                android:fontFamily="@font/robotoslab_regular"
                                android:text="@string/your_cart_is_empty"
                                android:gravity="center"
                                android:textColor="@color/dark_text_color"
                                android:textSize="@dimen/text_25" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
                <TextView

                    android:layout_width="@dimen/margin_200"
                    android:layout_height="45dp"
                    android:layout_marginTop="@dimen/margin_20"
                    android:background="@drawable/rounded_background"
                    android:elevation="@dimen/margin_3"
                    android:fontFamily="@font/robotoslab_regular"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:text="@string/explore_our_deals"
                    android:textAllCaps="false"
                    android:textColor="@color/white_color"
                    android:textSize="@dimen/text_16" />

            </LinearLayout>
        </LinearLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >

                <LinearLayout
                    android:layout_marginTop="@dimen/margin_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_20"
                    android:orientation="horizontal"
                    android:background="@color/white_color"
                    android:elevation="@dimen/margin_3"
                    >
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="3"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/margin_50"
                            android:scaleType="fitStart"
                            android:src="@drawable/test_3" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="2"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_height="match_parent">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/margin_25"
                            android:fontFamily="@font/robotoslab_regular"
                            android:background="@color/grey_lighter"
                            android:text="1325"
                            android:gravity="center"
                            android:textColor="@color/black_color"
                            android:textSize="@dimen/text_14" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_regular"
                            android:text="@string/orders"
                            android:gravity="center"
                            android:textColor="@color/grey_light"
                            android:textSize="@dimen/text_12" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="2"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_height="match_parent">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/margin_25"
                            android:fontFamily="@font/robotoslab_regular"
                            android:background="@color/grey_lighter"
                            android:text="4.8"
                            android:gravity="center"
                            android:textColor="@color/black_color"
                            android:textSize="@dimen/text_14" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_regular"
                            android:text="3251 Review"
                            android:gravity="center"
                            android:textColor="@color/grey_light"
                            android:textSize="@dimen/text_12" />
                    </LinearLayout>
                </LinearLayout>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_8"
                    app:cardCornerRadius="0dp"
                    app:cardElevation="@dimen/margin_3"
                    app:contentPadding="@dimen/padding_15"
                    app:cardUseCompatPadding="true">
                    <TextView
                        android:layout_marginTop="@dimen/margin_15"
                        android:layout_marginBottom="@dimen/margin_15"
                        android:padding="@dimen/padding_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/robotoslab_regular"
                        android:text="The chrome finish of this kitchen faucet is highly reflective.The chrome finish of this kitchen faucet is highly reflective.The chrome finish of this kitchen faucet is highly reflective.The chrome finish of this kitchen faucet is highly reflective."
                        android:layout_marginEnd="@dimen/margin_12"
                        android:textColor="@color/light_text_color"
                        android:textSize="@dimen/text_12" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>

    </LinearLayout>


</RelativeLayout>
