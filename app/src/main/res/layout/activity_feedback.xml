<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:card_view="http://schemas.android.com/tools">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white_color"
        >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/robotoslab_regular"
                android:text="@string/feedback"
                android:textColor="@color/white_color"
                android:textSize="@dimen/text_20" />

            <ImageView
                android:id="@+id/imgViewBack"
                android:layout_width="@dimen/margin_30"
                android:layout_height="@dimen/margin_30"
                android:layout_centerVertical="true"
                android:padding="@dimen/padding_3"
                android:layout_marginStart="@dimen/margin_5"
                android:src="@drawable/back_icon_auto_mirrored" />

            <support.ImageBadgeView
                android:id="@+id/imgCheckOut"
                android:layout_width="@dimen/margin_35"
                android:layout_height="@dimen/margin_35"
                android:layout_marginTop="@dimen/margin_10"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/margin_12"
                app:ibv_badgeValue="3"
                app:ibv_badgeTextSize="12sp"
                app:ibv_fixedBadgeRadius="8dp"
                app:ibv_badgeTextStyle="bold"
                app:ibv_badgeTextColor="@color/colorPrimary"
                app:ibv_badgePosition="top_right"
                app:ibv_badgeColor="@color/white_color"
                app:ibv_badgeLimitValue="false"
                android:src="@mipmap/ic_basket_empty" />
        </RelativeLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >

                <LinearLayout
                    android:layout_marginTop="@dimen/margin_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_20"
                    android:orientation="horizontal"
                    android:background="@color/white_color"
                    android:elevation="@dimen/margin_3"
                    >
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="3"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/margin_50"
                            android:scaleType="fitStart"
                            android:src="@drawable/test_3" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="2"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_height="match_parent">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/margin_25"
                            android:fontFamily="@font/robotoslab_regular"
                            android:background="@color/grey_lighter"
                            android:text="1325"
                            android:gravity="center"
                            android:textColor="@color/black_color"
                            android:textSize="@dimen/text_14" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_regular"
                            android:text="@string/orders"
                            android:gravity="center"
                            android:textColor="@color/grey_light"
                            android:textSize="@dimen/text_12" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="2"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_height="match_parent">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/margin_25"
                            android:fontFamily="@font/robotoslab_regular"
                            android:background="@color/grey_lighter"
                            android:text="4.8"
                            android:gravity="center"
                            android:textColor="@color/black_color"
                            android:textSize="@dimen/text_14" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_regular"
                            android:text="3251 Review"
                            android:gravity="center"
                            android:textColor="@color/grey_light"
                            android:textSize="@dimen/text_12" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/margin_12"
                    android:background="@color/white_color"
                    android:elevation="@dimen/margin_3"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_30"
                    >



                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_15"
                            android:background="@color/white_color"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:layout_weight="1">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/robotoslab_regular"
                                    android:text="@string/price"
                                    android:textColor="@color/black_color"
                                    android:textSize="@dimen/text_13" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <com.iarcuschin.simpleratingbar.SimpleRatingBar
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:srb_starSize="26dp"
                                    app:srb_numberOfStars="5"
                                    app:srb_rating="4.5"
                                    app:srb_stepSize="0.5"
                                    app:srb_borderColor="@color/transparent_color"
                                    app:srb_starBackgroundColor="@color/grey_white"
                                    card_view:srb_starBorderWidth="0.01"
                                    app:srb_fillColor="@color/yellow_star"
                                    />
                            </LinearLayout>
                        </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_12"
                        android:background="@color/white_color"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:layout_weight="1">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/robotoslab_regular"
                                android:text="@string/quality"
                                android:textColor="@color/black_color"
                                android:textSize="@dimen/text_13" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.iarcuschin.simpleratingbar.SimpleRatingBar
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:srb_starSize="26dp"
                                app:srb_numberOfStars="5"
                                app:srb_rating="4.5"
                                app:srb_stepSize="0.5"
                                app:srb_borderColor="@color/transparent_color"
                                app:srb_starBackgroundColor="@color/grey_white"
                                card_view:srb_starBorderWidth="0.01"
                                app:srb_fillColor="@color/yellow_star"
                                />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_12"
                        android:background="@color/white_color"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:layout_weight="1">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/robotoslab_regular"
                                android:text="@string/same_with_informations"
                                android:textColor="@color/black_color"
                                android:textSize="@dimen/text_13" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.iarcuschin.simpleratingbar.SimpleRatingBar
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:srb_starSize="26dp"
                                app:srb_numberOfStars="5"
                                app:srb_rating="4.5"
                                app:srb_stepSize="0.5"
                                app:srb_borderColor="@color/transparent_color"
                                app:srb_starBackgroundColor="@color/grey_white"
                                card_view:srb_starBorderWidth="0.01"
                                app:srb_fillColor="@color/yellow_star"
                                />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_12"
                        android:background="@color/white_color"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:layout_weight="1">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/robotoslab_regular"
                                android:text="@string/timing"
                                android:textColor="@color/black_color"
                                android:textSize="@dimen/text_13" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.iarcuschin.simpleratingbar.SimpleRatingBar
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:srb_starSize="26dp"
                                app:srb_numberOfStars="5"
                                app:srb_rating="4.5"
                                app:srb_stepSize="0.5"
                                app:srb_borderColor="@color/transparent_color"
                                app:srb_starBackgroundColor="@color/grey_white"
                                card_view:srb_starBorderWidth="0.01"
                                app:srb_fillColor="@color/yellow_star"
                                />
                        </LinearLayout>
                    </LinearLayout>

                    <RelativeLayout
                        android:layout_marginTop="@dimen/margin_30"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <EditText
                            android:id="@+id/message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/write_your_feedback"
                            android:paddingTop="@dimen/padding_8"
                            android:minHeight="@dimen/margin_150"
                            android:gravity="start"
                            android:background="@color/grey_lighter"
                            android:theme="@style/EditTextStyle" />
                        <ImageView
                            android:layout_width="@dimen/margin_35"
                            android:layout_height="@dimen/margin_35"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:padding="@dimen/padding_5"
                            android:src="@mipmap/ic_camera_empty"/>
                    </RelativeLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/robotoslab_regular"
                        android:padding="@dimen/padding_5"
                        android:text="@string/we_support_jpg_and_png_format"
                        android:textColor="@color/grey_light"
                        android:textSize="@dimen/text_12" />
                    <TextView
                        android:id="@+id/txtFeedback"
                        android:layout_width="@dimen/margin_250"
                        android:layout_height="45dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/margin_50"
                        android:layout_marginBottom="@dimen/margin_30"
                        android:background="@drawable/rounded_border"
                        android:fontFamily="@font/robotoslab_regular"
                        android:gravity="center"
                        android:text="@string/send_feedback"
                        android:textAllCaps="false"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/text_16" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>


</RelativeLayout>
