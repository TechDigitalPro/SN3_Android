<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/robotoslab_regular"
                android:text="@string/statistics"
                android:textColor="@color/white_color"
                android:textSize="@dimen/text_20" />

            <ImageView
                android:id="@+id/imgViewBack"
                android:layout_width="@dimen/margin_30"
                android:layout_height="@dimen/margin_30"
                android:layout_centerVertical="true"
                android:padding="@dimen/padding_3"
                android:layout_marginStart="@dimen/margin_5"
                android:src="@drawable/back_icon_auto_mirrored" />

            <support.ImageBadgeView
                android:id="@+id/imgCheckOut"
                android:layout_width="@dimen/margin_35"
                android:layout_height="@dimen/margin_35"
                android:layout_marginTop="@dimen/margin_10"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/margin_12"
                app:ibv_badgeValue="3"
                app:ibv_badgeTextSize="12sp"
                app:ibv_fixedBadgeRadius="8dp"
                app:ibv_badgeTextStyle="bold"
                app:ibv_badgeTextColor="@color/colorPrimary"
                app:ibv_badgePosition="top_right"
                app:ibv_badgeColor="@color/white_color"
                app:ibv_badgeLimitValue="false"
                android:src="@mipmap/ic_basket_empty" />
        </RelativeLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/padding_10"
                android:orientation="vertical"
                >
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_15"
                    android:orientation="vertical"
                    android:layout_gravity="center"
                    >

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabLayout"
                        android:layout_width="280dp"
                        android:layout_margin="@dimen/margin_3"
                        android:layout_height="@dimen/margin_35"
                        app:tabIndicator="@drawable/rounded_tab_background"
                        app:tabIndicatorGravity="stretch"
                        app:tabIndicatorColor="@color/colorPrimary"
                        app:tabTextColor="@color/dark_text_color"
                        app:tabSelectedTextColor="@color/white_color"
                        app:tabRippleColor="@android:color/transparent"
                        app:tabTextAppearance="@style/TabTextStyle"
                        >
                        <com.google.android.material.tabs.TabItem
                            android:text="@string/monthly"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <com.google.android.material.tabs.TabItem
                            android:text="@string/weekly"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <com.google.android.material.tabs.TabItem
                            android:text="@string/today"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                    </com.google.android.material.tabs.TabLayout>

                </LinearLayout>

                <com.github.mikephil.charting.charts.PieChart
                    android:layout_marginTop="@dimen/margin_3"
                    android:layout_marginBottom="@dimen/margin_3"
                    android:id="@+id/pie_chart"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_250" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_5"
                    android:orientation="horizontal"
                    android:background="@color/grey_lighter"
                    >

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/margin_25"
                        android:layout_marginEnd="@dimen/margin_25"
                        android:layout_height="wrap_content">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/margin_5"
                            android:background="@drawable/rounded_tab_background"
                            />
                        <TextView
                            android:layout_marginTop="@dimen/margin_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_regular"
                            android:text="53%"
                            android:layout_gravity="center"
                            android:textColor="@color/light_text_color"
                            android:textSize="@dimen/text_20" />

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/margin_25"
                        android:layout_marginEnd="@dimen/margin_25"
                        android:layout_height="wrap_content">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/margin_5"
                            android:background="@drawable/rounded_services_background"
                            />
                        <TextView
                            android:layout_marginTop="@dimen/margin_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_regular"
                            android:text="13%"
                            android:layout_gravity="center"
                            android:textColor="@color/light_text_color"
                            android:textSize="@dimen/text_20" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/margin_25"
                        android:layout_marginEnd="@dimen/margin_25"
                        android:layout_height="wrap_content">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/margin_5"
                            android:background="@drawable/rounded_cleaning_background"
                            />
                        <TextView
                            android:layout_marginTop="@dimen/margin_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_regular"
                            android:text="20%"
                            android:layout_gravity="center"
                            android:textColor="@color/light_text_color"
                            android:textSize="@dimen/text_20" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/margin_25"
                        android:layout_marginEnd="@dimen/margin_25"
                        android:layout_height="wrap_content">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/margin_5"
                            android:background="@drawable/rounded_tool_background"
                            />
                        <TextView
                            android:layout_marginTop="@dimen/margin_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_regular"
                            android:text="9%"
                            android:layout_gravity="center"
                            android:textColor="@color/light_text_color"
                            android:textSize="@dimen/text_20" />
                    </LinearLayout>


                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_marginTop="@dimen/margin_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_bold"
                            android:text="@string/buy"
                            android:layout_gravity="center"
                            android:textColor="@color/dark_text_color"
                            android:textSize="@dimen/text_11" />

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_marginTop="@dimen/margin_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_bold"
                            android:text="@string/services"
                            android:layout_gravity="center"
                            android:textColor="@color/dark_text_color"
                            android:textSize="@dimen/text_11" />

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_marginTop="@dimen/margin_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_bold"
                            android:text="@string/cleaning"
                            android:layout_gravity="center"
                            android:textColor="@color/dark_text_color"
                            android:textSize="@dimen/text_11" />

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_marginTop="@dimen/margin_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_bold"
                            android:text="@string/tools"
                            android:layout_gravity="center"
                            android:textColor="@color/dark_text_color"
                            android:textSize="@dimen/text_11" />

                    </LinearLayout>



                </LinearLayout>

                <com.github.mikephil.charting.charts.LineChart
                    android:layout_marginTop="@dimen/margin_30"
                    android:layout_marginBottom="@dimen/margin_12"
                    android:layout_marginStart="@dimen/margin_5"
                    android:layout_marginEnd="@dimen/margin_5"
                    android:id="@+id/line_chart"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_200"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_5"
                    android:orientation="horizontal"
                    android:background="@color/grey_lighter"
                    >

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/margin_25"
                        android:layout_marginEnd="@dimen/margin_25"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_marginTop="@dimen/margin_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_bold"
                            android:text="19"
                            android:layout_gravity="center"
                            android:textColor="@color/dark_text_color"
                            android:textSize="@dimen/text_20" />
                        <TextView
                            android:layout_marginTop="@dimen/margin_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_regular"
                            android:text="@string/contracts"
                            android:layout_gravity="center"
                            android:textColor="@color/black_color"
                            android:textSize="@dimen/text_11" />

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/margin_25"
                        android:layout_marginEnd="@dimen/margin_25"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_marginTop="@dimen/margin_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_bold"
                            android:text="43"
                            android:layout_gravity="center"
                            android:textColor="@color/dark_text_color"
                            android:textSize="@dimen/text_20" />
                        <TextView
                            android:layout_marginTop="@dimen/margin_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_regular"
                            android:text="@string/sales"
                            android:layout_gravity="center"
                            android:textColor="@color/black_color"
                            android:textSize="@dimen/text_11" />

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/margin_25"
                        android:layout_marginEnd="@dimen/margin_25"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_marginTop="@dimen/margin_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_bold"
                            android:text="59%"
                            android:layout_gravity="center"
                            android:textColor="@color/dark_text_color"
                            android:textSize="@dimen/text_20" />
                        <TextView
                            android:layout_marginTop="@dimen/margin_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoslab_regular"
                            android:text="@string/reveneu"
                            android:layout_gravity="center"
                            android:textColor="@color/black_color"
                            android:textSize="@dimen/text_11" />

                    </LinearLayout>


                </LinearLayout>
            </LinearLayout>

        </ScrollView>

    </LinearLayout>





</RelativeLayout>