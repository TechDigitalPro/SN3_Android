<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/grey_lighter"
    xmlns:card_view="http://schemas.android.com/tools">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/robotoslab_regular"
                android:text="@string/the_service_selected"
                android:textColor="@color/white_color"
                android:textSize="@dimen/text_20" />

            <ImageView
                android:id="@+id/imgViewBack"
                android:layout_width="@dimen/margin_30"
                android:layout_height="@dimen/margin_30"
                android:layout_centerVertical="true"
                android:padding="@dimen/padding_3"
                android:layout_marginStart="@dimen/margin_5"
                android:src="@drawable/back_icon_auto_mirrored" />

            <support.ImageBadgeView
                android:id="@+id/imgCheckOut"
                android:layout_width="@dimen/margin_35"
                android:layout_height="@dimen/margin_35"
                android:layout_marginTop="@dimen/margin_10"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/margin_12"
                app:ibv_badgeValue="3"
                app:ibv_badgeTextSize="12sp"
                app:ibv_fixedBadgeRadius="8dp"
                app:ibv_badgeTextStyle="bold"
                app:ibv_badgeTextColor="@color/colorPrimary"
                app:ibv_badgePosition="top_right"
                app:ibv_badgeColor="@color/white_color"
                app:ibv_badgeLimitValue="false"
                android:src="@mipmap/ic_basket_empty" />
        </RelativeLayout>
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="0dp"
                    app:cardElevation="@dimen/margin_3"
                    app:cardUseCompatPadding="true">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_5"
                            android:layout_marginBottom="@dimen/margin_5"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="3"

                                android:orientation="horizontal"
                                android:layout_height="match_parent">


                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_gravity="center"
                                    android:paddingStart="@dimen/padding_5"
                                    android:paddingEnd="@dimen/padding_5"
                                    android:src="@drawable/test_2" />
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="3"
                                android:orientation="vertical"
                                android:padding="@dimen/padding_3"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/robotoslab_regular"
                                    android:text="Home Cleaning"
                                    android:textColor="@color/colorPrimary"
                                    android:textSize="@dimen/text_15" />
                                <TextView
                                    android:layout_marginTop="@dimen/margin_5"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/robotoslab_regular"
                                    android:text="1 Month Contract"
                                    android:textColor="@color/dark_text_color"
                                    android:textSize="@dimen/text_12" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/robotoslab_regular"
                                    android:text="@string/lead_time"
                                    android:textColor="@color/dark_text_color"
                                    android:textSize="@dimen/text_12" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/robotoslab_regular"
                                    android:text="@string/visiting"
                                    android:textColor="@color/dark_text_color"
                                    android:textSize="@dimen/text_12" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/robotoslab_bold"
                                    android:text="@string/nationality"
                                    android:textColor="@color/dark_text_color"
                                    android:textSize="@dimen/text_12" />


                            </LinearLayout>



                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            >
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/robotoslab_bold"
                                android:text="@string/description"
                                android:textAllCaps="false"
                                android:textColor="@color/black_color"
                                android:layout_marginStart="@dimen/margin_8"
                                android:layout_marginTop="@dimen/margin_12"
                                android:textSize="@dimen/text_13" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/robotoslab_regular"
                                android:background="@drawable/rounded_border_grey"
                                android:padding="@dimen/padding_10"
                                android:text="The chrome finish of this kitchen faucet is highly reflective.The chrome finish of this kitchen faucet is highly reflective.The chrome finish of this kitchen faucet is highly reflective.The chrome finish of this kitchen faucet is highly reflective."
                                android:textAllCaps="false"
                                android:layout_gravity="center"
                                android:textColor="@color/black_color"
                                android:layout_margin="@dimen/margin_5"
                                android:textSize="@dimen/text_12" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/robotoslab_bold"
                                android:text="@string/available_option"
                                android:textAllCaps="false"
                                android:textColor="@color/black_color"
                                android:layout_marginStart="@dimen/margin_8"
                                android:layout_marginTop="@dimen/margin_12"
                                android:textSize="@dimen/text_13" />
                            <androidx.recyclerview.widget.RecyclerView
                                android:layout_marginStart="@dimen/margin_5"
                                android:layout_marginEnd="@dimen/margin_0"
                                android:id="@+id/rv_service_card_option"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/grey_lighter"

                                >

                                <LinearLayout
                                    android:layout_margin="@dimen/margin_8"
                                    android:layout_width="match_parent"
                                    android:layout_gravity="center"
                                    android:padding="@dimen/padding_5"
                                    android:gravity="center"
                                    android:background="@drawable/rounded_white_background"
                                    android:layout_height="@dimen/margin_50">

                                    <com.google.android.material.tabs.TabLayout
                                        android:layout_width="match_parent"
                                        android:layout_gravity="center"
                                        android:layout_height="match_parent"
                                        app:tabIndicator="@drawable/rounded_tab_background"
                                        app:tabIndicatorGravity="stretch"
                                        app:tabIndicatorColor="@color/colorPrimary"
                                        app:tabTextColor="@color/black_color"
                                        app:tabSelectedTextColor="@color/white_color"
                                        app:tabRippleColor="@android:color/transparent"
                                        app:tabTextAppearance="@style/TabTextStyle"
                                        >
                                        <com.google.android.material.tabs.TabItem
                                            android:text="@string/this_month"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"/>

                                        <com.google.android.material.tabs.TabItem
                                            android:text="@string/next_month"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"/>

                                    </com.google.android.material.tabs.TabLayout>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>


 </androidx.cardview.widget.CardView>

    </LinearLayout>


</RelativeLayout>
