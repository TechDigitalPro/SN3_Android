<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:paddingBottom="@dimen/margin_120"
    android:background="@drawable/ic_intro_bg"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_20"
        android:fontFamily="@font/robotoslab_bold"
        android:text="@string/introTitle3"
        android:textColor="@color/white_color"
        android:textSize="@dimen/text_30" />
    <ImageView
        android:layout_width="@dimen/margin_130"
        android:layout_height="@dimen/margin_130"
        android:src="@mipmap/ic_price"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/padding_25"
        android:paddingEnd="@dimen/padding_25"
        android:layout_marginTop="@dimen/margin_5"
        android:fontFamily="@font/robotoslab_regular"
        android:gravity="center"
        android:text="@string/introDesc3"
        android:textColor="@color/white_color"
        android:textSize="@dimen/text_14" />
</LinearLayout>