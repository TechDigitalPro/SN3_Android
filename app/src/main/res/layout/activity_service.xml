<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:focusableInTouchMode="true"
            android:focusable="true"

            >
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimary"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/robotoslab_regular"
                    android:text="@string/services"
                    android:textColor="@color/white_color"
                    android:textSize="@dimen/text_20" />

                <ImageView
                    android:id="@+id/imgViewBack"
                    android:layout_width="@dimen/margin_30"
                    android:layout_height="@dimen/margin_30"
                    android:layout_centerVertical="true"
                    android:padding="@dimen/padding_3"
                    android:layout_marginStart="@dimen/margin_5"
                    android:src="@drawable/back_icon_auto_mirrored" />

                <support.ImageBadgeView
                    android:id="@+id/imgCheckOut"
                    android:layout_width="@dimen/margin_35"
                    android:layout_height="@dimen/margin_35"
                    android:layout_marginTop="@dimen/margin_10"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="@dimen/margin_12"
                    app:ibv_badgeValue="3"
                    app:ibv_badgeTextSize="12sp"
                    app:ibv_fixedBadgeRadius="8dp"
                    app:ibv_badgeTextStyle="bold"
                    app:ibv_badgeTextColor="@color/colorPrimary"
                    app:ibv_badgePosition="top_right"
                    app:ibv_badgeColor="@color/white_color"
                    app:ibv_badgeLimitValue="false"
                    android:src="@mipmap/ic_basket_empty" />
            </RelativeLayout>
            <androidx.appcompat.widget.SearchView
                android:id="@+id/search_view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_40"
                android:layout_marginStart="@dimen/margin_10"
                android:layout_marginEnd="@dimen/margin_10"
                android:layout_marginTop="@dimen/margin_5"
                android:layout_marginBottom="@dimen/margin_5"
                android:fontFamily="@font/robotoslab_regular"
                android:background="@drawable/rounded_search_bar"
                app:iconifiedByDefault="false"
                app:queryHint="@string/search" />
           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="vertical"
               >


                   <LinearLayout
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:orientation="vertical"
                       >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"

                        >

                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_marginStart="@dimen/margin_5"
                            android:layout_marginEnd="@dimen/margin_0"
                            android:id="@+id/rv_services"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/padding_5"
                            android:orientation="vertical">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:fontFamily="@font/robotoslab_regular"
                                    android:text="2543 Items"
                                    android:textColor="@color/dark_text_color"
                                    android:textSize="@dimen/text_12" />
                                <ImageView
                                    android:id="@+id/sort_type"
                                    android:layout_width="@dimen/margin_45"
                                    android:layout_height="@dimen/margin_45"
                                    android:padding="@dimen/padding_3"
                                    android:src="@mipmap/ic_list"
                                    android:layout_centerInParent="true"/>
                                <ImageView
                                    android:id="@+id/grid_type"
                                    android:layout_width="@dimen/margin_45"
                                    android:layout_height="@dimen/margin_45"
                                    android:padding="@dimen/padding_3"
                                    android:src="@mipmap/ic_multiple_click"
                                    android:layout_alignParentEnd="true"/>
                            </RelativeLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_services_detail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>

                    </LinearLayout>

                   </LinearLayout>


           </LinearLayout>
        </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>